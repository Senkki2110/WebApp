@model IEnumerable<WebApp.Model.CentroDeportivo>

@section Styles {
    <link rel="stylesheet" href="~/css/centrosdeportivo.css" />
}


@{
    ViewData["Title"] = "Centros Deportivos";
    }

    <link rel="stylesheet" href="~/css/centrodeportivo.css" />

    <nav class="nav_menu">
        <ul class="nav_links">
            <li><a href="/">Inicio</a></li>
            <li><a href="/acercade">Acerca de</a></li>
            <li><a href="/centrosdeportivos">Centros deportivos</a></li>
            <li><a href="/info">Info</a></li>
            <li><a href="/mapa">Mapa</a></li>
            <li><a href="/login">Login</a></li>
            <li><a href="/registro">Registro</a></li>
        </ul>
    </nav>

    <main class="centros-container">
        <h2>Centros Deportivos Disponibles</h2>
        <p>
            Aquí encontrarás una lista de centros deportivos registrados en nuestra plataforma,
            con información de ubicación, horarios y servicios disponibles.
        </p>

        <section class="card-container">

            @foreach (var item in Model)
        {
            <article class="card">
                <img src="~/images/centro-default.jpg" alt="@item.Nombre" />

                <h2>@item.Nombre</h2>

                <p><strong>Ubicación:</strong> @item.Direccion</p>
                <p><strong>Teléfono:</strong> @item.Telefono</p>
                <p><strong>Correo:</strong> @item.Correo</p>

                <p><strong>Horario:</strong> @item.Apertura - @item.Cierre</p>

                <p><strong>Capacidad:</strong> @item.Capacidad personas</p>

                <strong>Estado:</strong> @item.Estado

                <div class="card-buttons">
                    <a class="btn-card" asp-action="Edit" asp-route-id="@item.Rut">Editar</a>
                    <a class="btn-card" asp-action="Details" asp-route-id="@item.Rut">Detalles</a>
                    <a class="btn-card btn-delete" asp-action="Delete" asp-route-id="@item.Rut">Eliminar</a>
                </div>
            </article>
        }

        </section>
    </main>
